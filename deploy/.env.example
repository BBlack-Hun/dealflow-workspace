# 운영 환경변수 예시.  deploy/.env 로 복사해서 채운다.
#
#     cp deploy/.env.example deploy/.env
#
# **deploy/.env 는 절대 커밋하지 않는다** (.gitignore 에 있다).
# 이 저장소는 공개다 — 여기 적힌 값은 예시일 뿐 실제 값이 아니다.

# ── 주소 ─────────────────────────────────────────────────────────────────────
# DuckDNS 등에서 잡은 이름. Caddy 가 이 이름으로 인증서를 받는다.
# 이 주소가 각자 PC 의 agent/config.yaml 에 들어간다 — 바꾸면 전부 고쳐야 한다.
DEALFLOW_DOMAIN=바꾸세요.duckdns.org

# ── 반드시 바꿔야 뜬다 (app/config.py assert_ready) ──────────────────────────
# 새 계정의 초기 비밀번호. 첫 로그인 때 변경을 요구하지만, 그 전까지는
# 이 값으로 들어올 수 있다. 저장소 기본값(dealflow123)이면 서버가 뜨지 않는다.
DEALFLOW_INITIAL_PASSWORD=

# 데모 시드용 토큰. 평소 발송은 계정별 난수 토큰을 쓰므로 이 값이 쓰이지
# 않지만, 기본값이면 서버가 뜨지 않는다(데모 시드와 겹치는 사고 방지).
#     openssl rand -hex 24
DEALFLOW_AGENT_TOKEN=

# 실데이터에 가상 기업이 섞이지 않게. 운영에서는 반드시 0.
DEALFLOW_SEED_DEMO=0

# ── 발송 ─────────────────────────────────────────────────────────────────────
# 값이 있으면 **모든 발송이 이 카톡방 하나로만** 나간다.
# 처음 올린 뒤 한두 건 확인할 때 자기 방 이름을 넣고, 확인이 끝나면 비운다.
DEALFLOW_TEST_ROOM=

# 카톡방 제목 끝에 붙는 고정 문구.
DEALFLOW_ROOM_SUFFIX=

# ── 메일 (안 쓰면 비워 둔다 — 비면 발송 화면에서 메일 채널이 안 보인다) ─────
DEALFLOW_SMTP_HOST=
DEALFLOW_SMTP_PORT=587
DEALFLOW_SMTP_USER=
DEALFLOW_SMTP_PASSWORD=
DEALFLOW_SMTP_FROM=
DEALFLOW_SMTP_TLS=1
DEALFLOW_SMTP_SSL=

# ── 기타 ─────────────────────────────────────────────────────────────────────
# 회차일·후속 예약일이 전부 이 시간대로 계산된다. UTC 면 하루 어긋난다.
TZ=Asia/Seoul
