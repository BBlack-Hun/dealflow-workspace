# ── 비밀/자격증명 (절대 커밋 금지) ──────────────────────────────
.env
.env.*
!.env.example
*.key
*.token
agent/config.local.yaml

# ── 파이썬 ────────────────────────────────────────────────────
__pycache__/
*.py[cod]
.venv/
.venv-agent/
venv/
*.egg-info/
.pytest_cache/

# ── 데이터/런타임 산출물 ───────────────────────────────────────
*.db
*.sqlite
*.sqlite3
data/
agent_logs/
# IR 자료 — 사람이 손으로 넣는 실물 파일. 폴더 자리는 각자 웹에서 정하지만
# (보통 저장소 밖), 저장소 안을 가리켰을 때를 위한 안전망이다.
# **저장소가 공개라 실제 자료가 올라가면 안 된다.**
ir_files/
ir_materials/
*.log

# ── 빌드 산출물 ───────────────────────────────────────────────
dist/
build/
*.zip

# ── OS/에디터 ─────────────────────────────────────────────────
.DS_Store
.idea/
.vscode/

# 서브에이전트가 잠깐 쓰는 작업 폴더 — 저장소에 들어갈 것이 아니다
.claude/worktrees/
