#!/usr/bin/env bash
# 더블클릭으로 설치가 끝나게 하는 파일.
#
# 예전에는 설치 안내에 터미널 명령을 적어 두었는데, 쓰는 사람이 그걸 알아야 할 이유가 없다.
# Finder 에서 이 파일을 더블클릭하면 창이 하나 열리고 설치가 진행된다.
cd "$(dirname "$0")" || exit 1
clear
echo "============================================"
echo " dealflow 발송 프로그램 설치"
echo "============================================"
echo
bash setup.sh
STATUS=$?
echo
if [ $STATUS -eq 0 ]; then
  echo "설치가 끝났습니다."
  echo "이제 '2. 발송 프로그램 켜기' 를 더블클릭하세요."
else
  echo "설치 중 문제가 있었습니다. 위 내용을 그대로 담당자에게 보여주세요."
fi
echo
echo "이 창은 닫아도 됩니다."
