# dealflow 환경변수 예시 (.env 로 복사해 사용). 비밀값은 커밋하지 마세요 (TECH_SPEC §7.4).

# 웹앱
DATABASE_URL=sqlite:////app/data/dealflow.db
DEALFLOW_CURRENT_USER_ID=1

# 발송 에이전트 토큰 (웹앱 시드 + 에이전트 공유). 운영 시 웹 화면에서 재발급 값으로 교체.
DEALFLOW_AGENT_TOKEN=agt_demo_token_sprint1

# (Sprint 4) CoolSMS OTP — 아직 미사용
# COOLSMS_API_KEY=
# COOLSMS_API_SECRET=
