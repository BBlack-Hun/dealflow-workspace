# dealflow 환경변수 예시 (.env 로 복사해 사용). 비밀값은 커밋하지 마세요 (TECH_SPEC §7.4).

# 웹앱
DATABASE_URL=sqlite:////app/data/dealflow.db
DEALFLOW_CURRENT_USER_ID=1

# 발송 에이전트 토큰 (웹앱 시드 + 에이전트 공유). 운영 시 웹 화면에서 재발급 값으로 교체.
DEALFLOW_AGENT_TOKEN=agt_demo_token_sprint1


# 테스트 모드: 값이 있으면 모든 발송이 이 카톡방 하나로만 나간다.
# 실제 투자사에게 잘못 발송되는 사고를 막는 안전장치. 운영 시에는 반드시 비워둘 것.
# 예) DEALFLOW_TEST_ROOM=김정훈
DEALFLOW_TEST_ROOM=

# 신규 계정 초기 비밀번호 (전원 동일). 첫 로그인 시 변경이 강제됩니다.
# 운영에서는 반드시 바꿔서 쓰세요.
DEALFLOW_INITIAL_PASSWORD=dealflow123

# ── 메일 발송 (카톡으로 받지 않는 투자사용) ──────────────────
# 메일은 각자 PC가 아니라 서버가 바로 보낸다. 값이 채워지면 발송 화면에서
# 이메일 채널을 고를 수 있게 되고, 비어 있으면 아예 고를 수 없다.
DEALFLOW_SMTP_HOST=
DEALFLOW_SMTP_PORT=587
DEALFLOW_SMTP_USER=
DEALFLOW_SMTP_PASSWORD=
DEALFLOW_SMTP_FROM=
# 587 은 접속 후 STARTTLS, 465 는 처음부터 SSL 이다. 방식이 달라서
# 465 인데 STARTTLS 로 붙으면 손도 못 대고 끊긴다.
# 비워 두면 포트로 알아서 정한다(465 → SSL).
DEALFLOW_SMTP_TLS=1
DEALFLOW_SMTP_SSL=

# ── 결과 문의 문자 알림 (팀원에게만) ──────────────────────────
# 미팅 결과를 물어볼 때가 되면 담당 팀원에게 문자로 알린다.
# **받는 사람은 우리 팀원뿐이다** — 투자사에게는 이 길로 보내지 않는다.
# 값이 하나라도 비면 아무 일도 일어나지 않는다(알림 실이 뜨지 않는다).
#
# 업체는 솔라피(SOLAPI). 발신번호는 업체에 **미리 등록해 둔 번호**여야 한다.
DEALFLOW_SMS_API_KEY=
DEALFLOW_SMS_API_SECRET=
DEALFLOW_SMS_FROM=

# 문자에 넣는 링크가 이 주소를 쓴다 (https 로 붙는다).
# 운영에서는 Caddy 가 인증서를 받는 그 이름과 같아야 한다 — deploy/.env 참고.
DEALFLOW_DOMAIN=
